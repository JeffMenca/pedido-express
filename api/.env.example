NODE_ENV=development
APP_PROFILE=local
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=*

DATABASE_URL=postgres://pedido:pedido@localhost:5432/pedido_express
DATABASE_SSL=false

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h

GATEWAY_URL=http://localhost:4000
GATEWAY_API_KEY=
GATEWAY_WEBHOOK_SECRET=
GATEWAY_TIMEOUT_MS=5000
# Must be reachable from the gateway container (docker compose overrides it with http://api:3000/...)
WEBHOOK_CALLBACK_URL=http://host.docker.internal:3000/api/webhooks/payments
WEBHOOK_TOLERANCE_SECONDS=300
RECONCILIATION_INTERVAL_MS=10000

# Optional fixed business date for coupon validity (ISO). Defaults to the real clock.
# BUSINESS_DATE=2026-10-30
